# --- CreateFlow environment ---

# Database. Dev default is SQLite (no install needed).
# Production: set provider="postgresql" in prisma/schema.prisma and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# 32+ char secret used to sign session cookies.
SESSION_SECRET="change-me-32-chars-minimum-secret-value-here"

APP_URL="http://localhost:3000"

# --- Background jobs (Phase 3) ---
# inline = run in-process (dev, no Redis). bullmq = Redis-backed worker (`npm run worker`).
QUEUE_DRIVER=inline
# REDIS_URL="redis://localhost:6379"     # required when QUEUE_DRIVER=bullmq

# --- Object storage (Phase 3/5) ---
# local = on-disk ./storage (dev). s3 = any S3-compatible bucket (S3 / R2 / MinIO).
STORAGE_DRIVER=local
STORAGE_DIR="./storage"
# S3_ENDPOINT="http://localhost:9000"    # MinIO/R2 endpoint (omit for AWS S3)
# S3_REGION="auto"
# S3_BUCKET="createflow"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- AI providers ---
# Per-capability: mock (offline, no key) | cloudflare (Workers AI, free tier) |
# openai | gemini.
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_VISION_PROVIDER=mock
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# Cloudflare Workers AI (free-tier prototyping)
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_TEXT_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
# CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
# CLOUDFLARE_VISION_MODEL="@cf/meta/llama-3.2-11b-vision-instruct"

# --- Etsy (Phase 7) ---
# TOKEN_ENC_KEY=""                        # AES key to encrypt Etsy OAuth tokens
# ETSY_CLIENT_ID=""
# ETSY_CLIENT_SECRET=""
# ETSY_REDIRECT_URI="http://localhost:3000/api/etsy/oauth/callback"
